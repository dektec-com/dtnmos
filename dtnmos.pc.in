# The prefix is found from where the file is, so that an install to any prefix works.
prefix=${pcfiledir}/@DTNMOS_PC_PREFIX_FROM_PCDIR@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: dtnmos
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
@DTNMOS_PC_REQUIRES@
Libs: -L${libdir} -ldtnmos
Libs.private: @DTNMOS_PC_LIBS_PRIVATE@
Cflags: -I${includedir} @DTNMOS_PC_CFLAGS@
